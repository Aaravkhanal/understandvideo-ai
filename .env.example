# Optional cloud vision inference
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT=60
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_TIMEOUT=180

# Free local speech-to-text and speaker identification (default).
TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_BEAM_SIZE=5
LOCAL_SPEAKER_DIARIZATION=true
LOCAL_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# HUGGINGFACE_TOKEN is optional after `hf auth login`; never commit a real token.
HUGGINGFACE_TOKEN=

# Local development identity. Production should replace this with verified auth.
LOCAL_ACCOUNT_ID=local-account
LOCAL_WORKSPACE_ID=local-workspace
LOCAL_WORKSPACE_NAME=Personal workspace

# Optional separate grounded-answer process (run with npm run dev:worker).
VIDEO_WORKER_URL=
VIDEO_WORKER_TOKEN=
VIDEO_WORKER_TIMEOUT=90
WORKER_MEDIA_ROOT=

# API limits
MAX_UPLOAD_BYTES=104857600
CHAT_REQUESTS_PER_HOUR=50
UPLOADS_PER_HOUR=20
MAX_REMOTE_DURATION_SECONDS=3600
REMOTE_IMPORT_TIMEOUT_SECONDS=180
IMPORT_AUTO_RETRIES=2

# off, optional, or required. optional uses clamdscan/clamscan when installed.
MALWARE_SCAN_MODE=optional

# New non-demo videos expire automatically. Allowed: 0 (keep), 30, 90, 365.
DEFAULT_RETENTION_DAYS=90
UPLOAD_ROOT=server/uploads
DATABASE_PATH=server/understandvideo.db

# Poll interval for `npm run jobs`.
JOB_POLL_SECONDS=3

# Optional comma-separated additions to the built-in public platform allowlist.
# Direct HTTPS links ending in a supported video extension do not need this.
REMOTE_MEDIA_HOSTS=

# Local browser origins allowed to call the API
CORS_ORIGINS=http://localhost:4310,http://127.0.0.1:4310

# Leave blank when Vite proxies /api to the local FastAPI server
VITE_API_URL=

# Supabase authentication. The publishable key is intentionally browser-safe;
# never place a Supabase secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
OIDC_ISSUER_URL=
OIDC_AUDIENCE=authenticated

# Private object storage. Supabase Storage can be used without a separate R2
# subscription; keep the service-role/secret key server-side only.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
