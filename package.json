{
  "name": "understandvideo-ai-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api --prefix-colors green,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1 --port 4310 --strictPort --open",
    "dev:api": "scripts/with-local-env.sh scripts/python.sh -m uvicorn server.main:app --reload --reload-exclude '.venv/**' --reload-exclude 'server/uploads/**' --host 127.0.0.1 --port 8787",
    "dev:worker": "scripts/with-local-env.sh scripts/python.sh -m uvicorn server.worker:app --reload --reload-exclude '.venv/**' --reload-exclude 'server/uploads/**' --host 127.0.0.1 --port 8788",
    "jobs": "scripts/with-local-env.sh scripts/python.sh -m server.job_worker",
    "validate:production": "scripts/with-local-env.sh scripts/python.sh scripts/validate_production_config.py",
    "build": "vite build",
    "preview": "vite preview",
    "test:api": "scripts/python.sh -m unittest discover -s server/tests -v",
    "test:web": "node --test src/*.test.js",
    "check:python": "scripts/python.sh -m compileall -q server scripts video_chatgpt data quantitative_evaluation",
    "check": "npm run build && npm run test:web && npm run check:python && npm run test:api",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
