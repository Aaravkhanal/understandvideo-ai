# Copy to .env.production on the production host. Put real values in a secret
# manager and inject them at runtime; never commit that file.
MALWARE_SCAN_MODE=required
DEFAULT_RETENTION_DAYS=90
MAX_UPLOAD_BYTES=104857600
MAX_REMOTE_DURATION_SECONDS=3600
REMOTE_IMPORT_TIMEOUT_SECONDS=180
JOB_POLL_SECONDS=3
CORS_ORIGINS=https://video.example.com
UPLOAD_ROOT=/app/server/uploads
DATABASE_PATH=/app/server/runtime/understandvideo.db

# Generate at least 32 random characters in your deployment secret manager.
VIDEO_WORKER_TOKEN=replace-from-secret-manager-at-deploy-time
DATABASE_URL=postgresql://replace-from-secret-manager
REDIS_URL=redis://replace-from-secret-manager

# Recommended identity choice: Supabase Auth using its OIDC/JWT configuration.
OIDC_ISSUER_URL=https://your-project.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated

# Private S3-compatible bucket. The application adapter is the next integration step.
OBJECT_STORAGE_BUCKET=understandvideo-private
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_SIGNED_URL_SECONDS=300

TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small
# Keep false in the lightweight import worker. Enable in a dedicated model worker
# that installs server/requirements.txt and receives the Hugging Face secret.
LOCAL_SPEAKER_DIARIZATION=false
